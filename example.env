# =====================================================================
# Gagaragogo Userbot - Örnek Yapılandırma Dosyası (.env)
# Bu dosyayı '.env' olarak kopyalayın ve kendi bilgilerinizi girin.
# =====================================================================

# ---------------------------------------------------------------------
# 🔴 1. ZORUNLU ALANLAR (REQUIRED)
# Bu ayarlar girilmeden bot kesinlikle çalışmaz!
# ---------------------------------------------------------------------

# Telegram API ID ve Hash bilgileri (https://my.telegram.org adresinden alınır)
API_ID=12345678
API_HASH=abcdef0123456789abcdef0123456789

# Pyrogram v2 String Session (Hesabınıza Userbot olarak bağlanmak için zorunludur)
# Herhangi bir Pyrogram session oluşturucu ile alınabilir.
STRING_SESSION=1BVts...kullanici_session_dizesi...


# ---------------------------------------------------------------------
# 🟡 2. ŞİDDETLE TAVSİYE EDİLEN (HIGHLY RECOMMENDED)
# ---------------------------------------------------------------------

# Telegram Yardımcı Bot Tokeni (@BotFather üzerinden alınır)
# NOT: Butonlu yardım menüsü (.yardim), ayarlar paneli (.ayarlar) ve 
# interaktif Instagram inline gezgini (.ig) için bu bot tokeni gereklidir.
# Girilmezse sadece metin tabanlı komutlar çalışır, inline menüler devre dışı kalır.
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRstuVWXyz_token


# ---------------------------------------------------------------------
# 🟢 3. OPSİYONEL ALANLAR (OPTIONAL)
# Girilmediğinde sistem otomatik varsayılan değerleri veya otomasyonu kullanır.
# ---------------------------------------------------------------------

# Ana Admin & Arşiv Grubu ID'si (Örn: -100 ile başlayan süpergroup ID'si)
# 💡 BÜYÜK KOLAYLIK: Bu alanı BOŞ bırakırsanız, bot ilk başladığında kendisi
# otomatik olarak "GagaraGogo Admin & Arşiv" adında Forum özellikli bir grup kurar,
# yardımcı botu yönetici yapar ve tüm alt konuları açar!
# Manuel bir grup bağlamak isterseniz grup ID'sini buraya yazabilirsiniz.
YEDEK_GRUP_ID=

# Instagram (.ig, .igstory, .igpost) komutları için RapidAPI anahtarları.
# Birden fazla anahtarınız varsa aralarına virgül koyarak yazabilirsiniz (otomatik rotasyon yapar).
# Örn: key1,key2,key3
RAPIDAPI_KEYS=

# Web Sağlık Kontrolü (Health Check) Portu
# Koyeb, Render, Heroku vb. bulut platformlarında botun uyumasını önlemek için 
# dahili HTTP sunucusu açar. Genellikle platform tarafından otomatik atanır (Varsayılan: 8080).
PORT=8080

# Güncelleme (.update) için GitHub Kaynak Deposu
# Kendi fork ettiğiniz bir repoyu kullanıyorsanız URL'yi buraya yazabilirsiniz.
# Varsayılan: https://github.com/chaolcam/gagaragogo-userbot.git
UPSTREAM_REPO=https://github.com/chaolcam/gagaragogo-userbot.git
